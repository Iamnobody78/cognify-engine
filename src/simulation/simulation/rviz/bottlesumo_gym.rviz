Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.0
      Name: Current View
      Pitch: 0.785
      Target Frame: <Fixed Frame>
      Yaw: 0.0
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Plane Cell Count: 20
      Cell Size: 0.1
      Line Style: Lines
      Color: 0.35; 0.35; 0.35
    - Class: rviz_default_plugins/MarkerArray
      Name: BottleSumo Markers
      Enabled: true
      Topic:
        Value: /bottlesumo/vis/markers
        Depth: 5
        Durability Policy: Volatile
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
  Global Options:
    Fixed Frame: dohyo
    Background Color: 0.05; 0.05; 0.08
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
  Views:
    - Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 2.0
      Pitch: 0.785
      Yaw: 0.0
Window Geometry:
  Height: 900
  Width: 1200
