<?xml version="1.0"?>
<robot name="bottlesumo" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       BottleSumo Rev1 - Complete Hardware URDF (Mesh Edition)
       PCB: 150x150mm, N20 motor x2, 2S LiPo, Pi 4B, STM32F103
       TCRT5000 x4, VL53L5CX ToF, SG90 pusher
       All visuals reference STL meshes in meshes/
       ============================================================ -->

  <!-- ==================== Materials ==================== -->
  <material name="fr4_green">
    <color rgba="0.1 0.4 0.1 1.0" />
  </material>
  <material name="plastic_black">
    <color rgba="0.15 0.15 0.15 1.0" />
  </material>
  <material name="aluminum">
    <color rgba="0.6 0.6 0.65 1.0" />
  </material>
  <material name="rubber_black">
    <color rgba="0.05 0.05 0.05 1.0" />
  </material>
  <material name="red">
    <color rgba="0.9 0.1 0.1 1.0" />
  </material>
  <material name="blue_chip">
    <color rgba="0.1 0.2 0.6 1.0" />
  </material>

  <!-- ==================== Physical Properties (meters) ==================== -->
  <xacro:property name="pcb_length" value="0.150" />
  <xacro:property name="pcb_width" value="0.150" />
  <xacro:property name="pcb_thick" value="0.0016" />
  <xacro:property name="body_length" value="0.160" />
  <xacro:property name="body_width" value="0.160" />
  <xacro:property name="body_height" value="0.050" />
  <xacro:property name="wheel_radius" value="0.017" />
  <xacro:property name="wheel_width" value="0.015" />
  <xacro:property name="wheel_offset_x" value="0.040" />
  <xacro:property name="wheel_offset_y" value="0.065" />
  <xacro:property name="caster_offset" value="0.055" />
  <xacro:property name="z_ground_clearance" value="0.008" />

  <!-- ==================== Masses (kg) ==================== -->
  <xacro:property name="mass_pcb" value="0.050" />
  <xacro:property name="mass_body" value="0.080" />
  <xacro:property name="mass_rpi" value="0.045" />
  <xacro:property name="mass_stm32" value="0.010" />
  <xacro:property name="mass_battery" value="0.100" />
  <xacro:property name="mass_motor" value="0.025" />
  <xacro:property name="mass_wheel" value="0.008" />
  <!-- N20 6V 300rpm gearmotor reflected inertia at wheel output:
       J_rotor ~ 1e-7 kg*m^2 (1 g*cm^2) x gear_ratio 40^2 x eta 0.8 = 1.28e-4 kg*m^2.
       Dominates wheel inertia (~1.2e-6) by ~100x; stabilizes diff-drive control loop.
       Source: models/motor_spec.json + .aionui/context/motor_consistency_audit.md -->
  <xacro:property name="J_motor_reflected" value="1.28e-4" />
  <xacro:property name="mass_caster" value="0.012" />
  <xacro:property name="mass_servo" value="0.009" />
  <xacro:property name="mass_pusher" value="0.015" />
  <xacro:property name="mass_tof" value="0.005" />

  <!-- ==================== Inertia Macros ==================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m/12.0 * (y*y + z*z)}" ixy="0.0" ixz="0.0"
             iyy="${m/12.0 * (x*x + z*z)}" iyz="0.0"
             izz="${m/12.0 * (x*x + y*y)}" />
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m/12.0 * (3.0*r*r + h*h)}" ixy="0.0" ixz="0.0"
             iyy="${m/12.0 * (3.0*r*r + h*h)}" iyz="0.0"
             izz="${m/2.0 * r*r}" />
  </xacro:macro>

  <!-- ════════════════════════════════════════════════════════════ -->
  <!--  LINKS  (visual = mesh, collision = primitive for physics)   -->
  <!-- ════════════════════════════════════════════════════════════ -->

  <!-- ===== base_link: virtual root ===== -->
  <link name="base_link" />

  <!-- ===== chassis: 3D printed body ===== -->
  <link name="chassis">
    <inertial>
      <mass value="${mass_body + mass_pcb}" />
      <origin xyz="0 0 0.020" />
      <xacro:box_inertia m="${mass_body + mass_pcb}"
                         x="${body_length}" y="${body_width}" z="${body_height}" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://bottlesumo_description/meshes/chassis.stl" />
      </geometry>
      <material name="plastic_black" />
    </visual>
    <collision>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}" />
      </geometry>
    </collision>
  </link>

  <!-- ===== pcb_board: FR4 PCB ===== -->
  <link name="pcb_board">
    <inertial>
      <mass value="${mass_pcb}" />
      <origin xyz="0 0 0.048" />
      <xacro:box_inertia m="${mass_pcb}" x="${pcb_length}" y="${pcb_width}" z="${pcb_thick}" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://bottlesumo_description/meshes/pcb_board.stl" />
      </geometry>
      <material name="fr4_green" />
    </visual>
  </link>

  <!-- ===== raspberry_pi: Pi 4B ===== -->
  <link name="raspberry_pi">
    <inertial>
      <mass value="${mass_rpi}" />
      <origin xyz="0 0.025 0.058" />
      <xacro:box_inertia m="${mass_rpi}" x="0.085" y="0.056" z="0.020" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://bottlesumo_description/meshes/raspberry_pi.stl" />
      </geometry>
      <material name="fr4_green" />
    </visual>
    <collision>
      <geometry>
        <box size="0.085 0.056 0.020" />
      </geometry>
    </collision>
  </link>

  <!-- ===== stm32_bluepill ===== -->
  <link name="stm32_bluepill">
    <inertial>
      <mass value="${mass_stm32}" />
      <origin xyz="-0.040 0 0.056" />
      <xacro:box_inertia m="${mass_stm32}" x="0.053" y="0.022" z="0.015" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://bottlesumo_description/meshes/stm32_bluepill.stl" />
      </geometry>
      <material name="blue_chip" />
    </visual>
    <collision>
      <geometry>
        <box size="0.053 0.022 0.015" />
      </geometry>
    </collision>
  </link>

  <!-- ===== battery_2s: 2S LiPo ===== -->
  <link name="battery_2s">
    <inertial>
      <mass value="${mass_battery}" />
      <origin xyz="0.030 0 0.025" />
      <xacro:box_inertia m="${mass_battery}" x="0.070" y="0.037" z="0.018" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://bottlesumo_description/meshes/battery_2s.stl" />
      </geometry>
      <material name="blue_chip" />
    </visual>
    <collision>
      <geometry>
        <box size="0.070 0.037 0.018" />
      </geometry>
    </collision>
  </link>

  <!-- ===== left_wheel ===== -->
  <link name="left_wheel">
    <inertial>
      <mass value="${mass_wheel}" />
      <!-- wheel cylinder inertia + N20 gearmotor reflected inertia on spin axis (izz) -->
      <inertia ixx="${mass_wheel/12.0*(3.0*wheel_radius*wheel_radius+wheel_width*wheel_width)}" ixy="0.0" ixz="0.0"
               iyy="${mass_wheel/12.0*(3.0*wheel_radius*wheel_radius+wheel_width*wheel_width)}" iyz="0.0"
               izz="${mass_wheel/2.0*wheel_radius*wheel_radius + J_motor_reflected}" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://bottlesumo_description/meshes/wheel.stl" />
      </geometry>
      <material name="rubber_black" />
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
      </geometry>
      <surface>
        <friction>
          <ode mu="1.0" mu2="1.0" />
        </friction>
      </surface>
    </collision>
  </link>

  <!-- ===== right_wheel ===== -->
  <link name="right_wheel">
    <inertial>
      <mass value="${mass_wheel}" />
      <!-- wheel cylinder inertia + N20 gearmotor reflected inertia on spin axis (izz) -->
      <inertia ixx="${mass_wheel/12.0*(3.0*wheel_radius*wheel_radius+wheel_width*wheel_width)}" ixy="0.0" ixz="0.0"
               iyy="${mass_wheel/12.0*(3.0*wheel_radius*wheel_radius+wheel_width*wheel_width)}" iyz="0.0"
               izz="${mass_wheel/2.0*wheel_radius*wheel_radius + J_motor_reflected}" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://bottlesumo_description/meshes/wheel.stl" />
      </geometry>
      <material name="rubber_black" />
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
      </geometry>
      <surface>
        <friction>
          <ode mu="1.0" mu2="1.0" />
        </friction>
      </surface>
    </collision>
  </link>

  <!-- ===== left_motor: N20 ===== -->
  <link name="left_motor">
    <inertial>
      <mass value="${mass_motor}" />
      <xacro:cylinder_inertia m="${mass_motor}" r="0.012" h="0.014" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://bottlesumo_description/meshes/n20_motor.stl" />
      </geometry>
      <material name="aluminum" />
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.012" length="0.014" />
      </geometry>
    </collision>
  </link>

  <!-- ===== right_motor: N20 ===== -->
  <link name="right_motor">
    <inertial>
      <mass value="${mass_motor}" />
      <xacro:cylinder_inertia m="${mass_motor}" r="0.012" h="0.014" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://bottlesumo_description/meshes/n20_motor.stl" />
      </geometry>
      <material name="aluminum" />
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.012" length="0.014" />
      </geometry>
    </collision>
  </link>

  <!-- ===== caster_wheel ===== -->
  <link name="caster_wheel">
    <inertial>
      <mass value="${mass_caster}" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://bottlesumo_description/meshes/caster_wheel.stl" />
      </geometry>
      <material name="aluminum" />
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.006" />
      </geometry>
      <surface>
        <friction>
          <ode mu="0.3" mu2="0.1" />
        </friction>
      </surface>
    </collision>
  </link>

  <!-- ===== tof_sensor: VL53L5CX ===== -->
  <link name="tof_sensor">
    <inertial>
      <mass value="${mass_tof}" />
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://bottlesumo_description/meshes/tof_sensor.stl" />
      </geometry>
      <material name="red" />
    </visual>
  </link>

  <!-- ===== servo_sg90 ===== -->
  <link name="servo_sg90">
    <inertial>
      <mass value="${mass_servo}" />
      <xacro:box_inertia m="${mass_servo}" x="0.023" y="0.012" z="0.029" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://bottlesumo_description/meshes/servo_sg90.stl" />
      </geometry>
      <material name="blue_chip" />
    </visual>
    <collision>
      <geometry>
        <box size="0.023 0.012 0.029" />
      </geometry>
    </collision>
  </link>

  <!-- ===== pusher_arm ===== -->
  <link name="pusher_arm">
    <inertial>
      <mass value="${mass_pusher}" />
      <xacro:box_inertia m="${mass_pusher}" x="0.060" y="0.002" z="0.040" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://bottlesumo_description/meshes/pusher_arm.stl" />
      </geometry>
      <material name="aluminum" />
    </visual>
    <collision>
      <geometry>
        <box size="0.060 0.002 0.040" />
      </geometry>
    </collision>
  </link>

  <!-- ===== edge_sensor_front: TCRT5000 ===== -->
  <link name="edge_sensor_front">
    <inertial>
      <mass value="0.003" />
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://bottlesumo_description/meshes/edge_sensor.stl" />
      </geometry>
      <material name="red" />
    </visual>
  </link>

  <link name="edge_sensor_back">
    <inertial>
      <mass value="0.003" />
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://bottlesumo_description/meshes/edge_sensor.stl" />
      </geometry>
      <material name="red" />
    </visual>
  </link>

  <link name="edge_sensor_left">
    <inertial>
      <mass value="0.003" />
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://bottlesumo_description/meshes/edge_sensor.stl" />
      </geometry>
      <material name="red" />
    </visual>
  </link>

  <link name="edge_sensor_right">
    <inertial>
      <mass value="0.003" />
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://bottlesumo_description/meshes/edge_sensor.stl" />
      </geometry>
      <material name="red" />
    </visual>
  </link>

  <!-- ════════════════════════════════════════════════════════════ -->
  <!--  JOINTS                                                       -->
  <!-- ════════════════════════════════════════════════════════════ -->

  <joint name="base_to_chassis" type="fixed">
    <parent link="base_link" />
    <child link="chassis" />
    <origin xyz="0 0 ${z_ground_clearance + body_height/2}" />
  </joint>

  <joint name="chassis_to_pcb" type="fixed">
    <parent link="chassis" />
    <child link="pcb_board" />
    <origin xyz="0 0 ${body_height/2 + pcb_thick/2}" />
  </joint>

  <joint name="pcb_to_rpi" type="fixed">
    <parent link="pcb_board" />
    <child link="raspberry_pi" />
    <origin xyz="0 0.025 ${pcb_thick/2 + 0.010}" />
  </joint>

  <joint name="pcb_to_stm32" type="fixed">
    <parent link="pcb_board" />
    <child link="stm32_bluepill" />
    <origin xyz="-0.040 0 ${pcb_thick/2 + 0.008}" />
  </joint>

  <joint name="chassis_to_battery" type="fixed">
    <parent link="chassis" />
    <child link="battery_2s" />
    <origin xyz="0.030 0 0" />
  </joint>

  <joint name="chassis_to_left_motor" type="fixed">
    <parent link="chassis" />
    <child link="left_motor" />
    <origin xyz="${wheel_offset_x} ${wheel_offset_y} ${-body_height/2 + 0.009}" rpy="0 ${3.14159/2} 0" />
  </joint>

  <joint name="chassis_to_right_motor" type="fixed">
    <parent link="chassis" />
    <child link="right_motor" />
    <origin xyz="${wheel_offset_x} ${-wheel_offset_y} ${-body_height/2 + 0.009}"
            rpy="0 ${3.14159/2} 0" />
  </joint>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="left_motor" />
    <child link="left_wheel" />
    <origin xyz="0 0 0" rpy="${-3.14159/2} 0 0" />
    <axis xyz="0 0 1" />
    <!-- N20 300rpm gearmotor joint dynamics (physical, verified by load test):
         Coulomb 0.02 Nm (7% of stall) + viscous damping 0.001 Nm*s/rad.
         Verified: FW_MAX cmd -> wheel 31.18 rad/s = 300rpm, odom 0.523 m/s (98% theory).
         NOTE: Gazebo classic does NOT hard-enforce joint <limit velocity>; speed cap is
         guaranteed by the 21-action table (FW_MAX=0.53 m/s) + firmware. Old friction=0.2
         was 21x motor torque -> robot crawled at 0.1 m/s (DEBT fixed in motor audit). -->
    <dynamics damping="0.001" friction="0.02" />
    <limit effort="0.3" velocity="31.4" />
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="right_motor" />
    <child link="right_wheel" />
    <origin xyz="0 0 0" rpy="${-3.14159/2} 0 0" />
    <axis xyz="0 0 1" />
    <!-- N20 300rpm gearmotor joint dynamics (physical, verified by load test):
         Coulomb 0.02 Nm (7% of stall) + viscous damping 0.001 Nm*s/rad.
         Verified: FW_MAX cmd -> wheel 31.18 rad/s = 300rpm, odom 0.523 m/s (98% theory).
         NOTE: Gazebo classic does NOT hard-enforce joint <limit velocity>; speed cap is
         guaranteed by the 21-action table (FW_MAX=0.53 m/s) + firmware. Old friction=0.2
         was 21x motor torque -> robot crawled at 0.1 m/s (DEBT fixed in motor audit). -->
    <dynamics damping="0.001" friction="0.02" />
    <limit effort="0.3" velocity="31.4" />
  </joint>

  <joint name="caster_joint" type="fixed">
    <parent link="chassis" />
    <child link="caster_wheel" />
    <origin xyz="${-caster_offset} 0 ${-body_height/2 - 0.002}" />
  </joint>

  <joint name="pcb_to_tof" type="fixed">
    <parent link="pcb_board" />
    <child link="tof_sensor" />
    <origin xyz="${pcb_length/2 + 0.006} 0 ${pcb_thick/2 + 0.002}" />
  </joint>

  <joint name="pcb_to_servo" type="fixed">
    <parent link="pcb_board" />
    <child link="servo_sg90" />
    <origin xyz="${pcb_length/2 - 0.015} 0 ${pcb_thick/2 + 0.015}" />
  </joint>

  <joint name="pusher_joint" type="revolute">
    <parent link="servo_sg90" />
    <child link="pusher_arm" />
    <origin xyz="0.015 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-0.785" upper="0.785" effort="1.0" velocity="2.0" />
    <dynamics damping="0.5" friction="0.1" />
  </joint>

  <joint name="pcb_to_sensor_front" type="fixed">
    <parent link="pcb_board" />
    <child link="edge_sensor_front" />
    <origin xyz="${pcb_length/2 - 0.005} 0 ${-pcb_thick/2 - 0.003}" rpy="0 0 0" />
  </joint>
  <joint name="pcb_to_sensor_back" type="fixed">
    <parent link="pcb_board" />
    <child link="edge_sensor_back" />
    <origin xyz="${-pcb_length/2 + 0.005} 0 ${-pcb_thick/2 - 0.003}" rpy="0 0 0" />
  </joint>
  <joint name="pcb_to_sensor_left" type="fixed">
    <parent link="pcb_board" />
    <child link="edge_sensor_left" />
    <origin xyz="0 ${pcb_width/2 - 0.005} ${-pcb_thick/2 - 0.003}" rpy="0 0 0" />
  </joint>
  <joint name="pcb_to_sensor_right" type="fixed">
    <parent link="pcb_board" />
    <child link="edge_sensor_right" />
    <origin xyz="0 ${-pcb_width/2 + 0.005} ${-pcb_thick/2 - 0.003}" rpy="0 0 0" />
  </joint>

  <!-- ════════════════════════════════════════════════════════════ -->
  <!--  GAZEBO SENSORS & PLUGINS                                     -->
  <!-- ════════════════════════════════════════════════════════════ -->

  <gazebo reference="chassis">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
  </gazebo>

  <gazebo reference="pusher_arm">
    <material>Gazebo/Grey</material>
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
  </gazebo>

  <!-- VL53L5CX ToF: Gazebo Ray sensor -->
  <gazebo reference="tof_sensor">
    <sensor name="tof_range" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <ray>
        <scan>
          <horizontal>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.3927</min_angle>
            <max_angle>0.3927</max_angle>
          </horizontal>
          <vertical>
            <samples>8</samples>
            <resolution>1</resolution>
            <min_angle>-0.19635</min_angle>
            <max_angle>0.19635</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.001</resolution>
        </range>
      </ray>
      <plugin name="tof_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/bottlesumo</namespace>
          <argument>~/out:=tof_scan</argument>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
      </plugin>
    </sensor>
  </gazebo>

  <!-- TCRT5000 x4: edge detection ray sensors -->
  <gazebo reference="edge_sensor_front">
    <sensor name="edge_ir_front" type="ray">
      <pose>0 0 -0.005 0 0 0</pose>
      <ray>
        <scan>
          <horizontal>
            <samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle>
          </horizontal>
        </scan>
        <range><min>0.001</min><max>0.015</max><resolution>0.001</resolution></range>
      </ray>
      <plugin name="edge_front_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros><namespace>/bottlesumo</namespace><argument>~/out:=edge_front</argument></ros>
        <output_type>sensor_msgs/Range</output_type>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="edge_sensor_back">
    <sensor name="edge_ir_back" type="ray">
      <pose>0 0 -0.005 0 0 0</pose>
      <ray>
        <scan>
          <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
        </scan>
        <range><min>0.001</min><max>0.015</max><resolution>0.001</resolution></range>
      </ray>
      <plugin name="edge_back_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros><namespace>/bottlesumo</namespace><argument>~/out:=edge_back</argument></ros>
        <output_type>sensor_msgs/Range</output_type>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="edge_sensor_left">
    <sensor name="edge_ir_left" type="ray">
      <pose>0 0 -0.005 0 0 0</pose>
      <ray>
        <scan>
          <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
        </scan>
        <range><min>0.001</min><max>0.015</max><resolution>0.001</resolution></range>
      </ray>
      <plugin name="edge_left_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros><namespace>/bottlesumo</namespace><argument>~/out:=edge_left</argument></ros>
        <output_type>sensor_msgs/Range</output_type>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="edge_sensor_right">
    <sensor name="edge_ir_right" type="ray">
      <pose>0 0 -0.005 0 0 0</pose>
      <ray>
        <scan>
          <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
        </scan>
        <range><min>0.001</min><max>0.015</max><resolution>0.001</resolution></range>
      </ray>
      <plugin name="edge_right_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros><namespace>/bottlesumo</namespace><argument>~/out:=edge_right</argument></ros>
        <output_type>sensor_msgs/Range</output_type>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Diff Drive Plugin -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/bottlesumo</namespace>
      </ros>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.13</wheel_separation>
      <wheel_diameter>0.034</wheel_diameter>
      <max_wheel_torque>0.3</max_wheel_torque>
      <max_wheel_acceleration>200.0</max_wheel_acceleration> <!-- N20 300rpm: 31.4 rad/s in ~0.16s (physical ramp) -->
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>

  <!-- DEBT-008: publish /joint_states so RViz shows wheel spin -->
  <gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros><namespace>/bottlesumo</namespace></ros>
      <update_rate>30</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <joint_name>pusher_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
