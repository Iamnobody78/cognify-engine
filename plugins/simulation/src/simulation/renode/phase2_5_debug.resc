# ==== Phase 2-5 Debug: Check RCC + PC to see where firmware is stuck ====
using sysbus

$firmware_main = @/mnt/c/Users/ivy/AppData/Roaming/AionUi/aionui/conversations/2026/07/27/aionrs-temp-48324704/bottlesumo_pi/firmware/stm32_mcu/build/bottlesumo_main.elf
$firmware_aux  = @/mnt/c/Users/ivy/AppData/Roaming/AionUi/aionui/conversations/2026/07/27/aionrs-temp-48324704/bottlesumo_pi/firmware/stm32_mcu/build/bottlesumo_aux.elf

mach create
machine LoadPlatformDescription @platforms/cpus/stm32f4.repl
sysbus LoadELF $firmware_main

mach create
machine LoadPlatformDescription @platforms/cpus/stm32f103.repl
sysbus LoadELF $firmware_aux

mach set 0
start
mach set 1
start

# Let them run just a fraction: 100us = enough for a few thousand instructions
sleep 0.0001

echo "=== F407 RCC status ==="
mach set 0
echo "RCC_CR (0x40023800):"
sysbus ReadDoubleWord 0x40023800
echo "RCC_CFGR (0x40023808):"
sysbus ReadDoubleWord 0x40023808
echo "PC:"
cpu PC

echo "=== F103 RCC status ==="
mach set 1
echo "RCC_CR (0x40021000):"
sysbus ReadDoubleWord 0x40021000
echo "RCC_CFGR (0x40021004):"
sysbus ReadDoubleWord 0x40021004
echo "PC:"
cpu PC

# Resume for more time
mach set 0
start
mach set 1
start
sleep 0.001

echo "=== After 1.1ms total ==="
mach set 0
echo "PC:"
cpu PC
echo "RCC_CR:"
sysbus ReadDoubleWord 0x40023800
mach set 1
echo "PC:"
cpu PC
echo "RCC_CR:"
sysbus ReadDoubleWord 0x40021000
