<?xml version="1.0" ?>
<!--
  CTEA Sumo Ring World — BottleSumo Rev2 Simulation
  Ring: 1.5m diameter (CTEA高级組 spec), white surface with black border
  Surface: flat plane, 5mm thick, friction coefficient tuned for hardboard
-->
<sdf version="1.9">
  <world name="ctea_sumo">

    <!-- ============================================================ -->
    <!-- Lighting                                                     -->
    <!-- ============================================================ -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- ============================================================ -->
    <!-- Ground Plane                                                 -->
    <!-- ============================================================ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>5 5</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>5 5</size></plane></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- CTEA Sumo Ring (1.5m diameter, 20mm high border)             -->
    <!-- ============================================================ -->
    <model name="sumo_ring">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>

      <!-- White surface disc (1.5m diameter) -->
      <link name="ring_surface">
        <pose>0 0 0 0 0 0</pose>
        <visual name="ring_visual">
          <geometry><cylinder><radius>0.75</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient></material>
        </visual>
        <collision name="ring_collision">
          <geometry><cylinder><radius>0.75</radius><length>0.005</length></cylinder></geometry>
          <surface>
            <friction>
              <ode><mu>0.6</mu><mu2>0.6</mu2></ode>
            </friction>
          </surface>
        </collision>
      </link>

      <!-- Black border ring (outer) -->
      <link name="ring_border">
        <pose>0 0 0 0 0 0</pose>
        <visual name="border_visual">
          <geometry><cylinder><radius>0.80</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient></material>
        </visual>
        <collision name="border_collision">
          <geometry><cylinder><radius>0.80</radius><length>0.005</length></cylinder></geometry>
          <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
        </collision>
      </link>

      <!-- Ring wall (20mm high border fence) -->
      <link name="ring_wall">
        <pose>0 0 0.01 0 0 0</pose>
        <visual name="wall_visual">
          <geometry>
            <!-- Hollow cylinder wall: outer radius 0.75, height 0.02 -->
            <cylinder><radius>0.75</radius><length>0.02</length></cylinder>
          </geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient></material>
        </visual>
        <collision name="wall_collision">
          <geometry><cylinder><radius>0.75</radius><length>0.02</length></cylinder></geometry>
          <surface>
            <bounce><restitution_coefficient>0.1</restitution_coefficient></bounce>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- Bottle Target (cylinder, placed at fixed position)           -->
    <!-- ============================================================ -->
    <model name="bottle_target">
      <static>true</static>
      <pose>0.5 0.3 0.001 0 0 0</pose>
      <link name="bottle_link">
        <visual name="bottle_visual">
          <geometry><cylinder><radius>0.035</radius><length>0.15</length></cylinder></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient></material>
        </visual>
        <collision name="bottle_collision">
          <geometry><cylinder><radius>0.035</radius><length>0.15</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>0.3</mu><mu2>0.3</mu2></ode></friction>
          </surface>
        </collision>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- BottleSumo Rev2 Robot                                       -->
    <!-- ============================================================ -->
    <include>
      <uri>model://bottlesumo_rev2</uri>
      <pose>0 0 0.005 0 0 0</pose>
    </include>

    <!-- ============================================================ -->
    <!-- Opponent Robot (simplified box proxy)                        -->
    <!-- ============================================================ -->
    <model name="opponent">
      <pose>0.8 0.2 0.001 0 0 3.1416</pose>  <!-- facing our robot -->
      <link name="opponent_link">
        <inertial><mass>0.300</mass><inertia>
          <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz>
          <izz>0.002</izz>
        </inertia></inertial>
        <visual name="opponent_visual">
          <geometry><box><size>0.200 0.180 0.040</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient></material>
        </visual>
        <collision name="opponent_collision">
          <geometry><box><size>0.200 0.180 0.040</size></box></geometry>
          <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- Physics Configuration                                        -->
    <!-- ============================================================ -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <gravity>0 0 -9.81</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
        </solver>
      </ode>
    </physics>

    <!-- ============================================================ -->
    <!-- GUI Camera preset                                            -->
    <!-- ============================================================ -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>1.5 0 1.8 0 0.5 0</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
