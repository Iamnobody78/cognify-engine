<?xml version="1.0" ?>
<!--
  BottleSumo Rev2 Gazebo Model (SDF 1.9)
  Generated by Meta-Harness Sim Pipeline, 2026-07-29
  References meshes from models/cad/ and sensor specs from Rev2 Architecture.
  
  Sensor plugins (match Rev2 hardware):
    - VL53L5CX multi-zone ToF (8x8, 60° FoV, 4m range) → bottle detector
    - VL53L1X long-range ToF (27° FoV, 4m range, 50ms timing) → bottle range
    - VL53L0X ×4 edge ToF (25° FoV, 2m, ±3% noise) → edge detection
    - MPU6050 IMU (gyro + accel)
    - Wheel encoders (48 CPR; motor N20 6V 300rpm — see models/motor_spec.json;
      note: prior "298:1 gearbox" was an encoder-spec artifact, see .aionui/context/motor_consistency_audit.md)
    - TB6612FNG PWM-driven motors
-->
<sdf version="1.9">
  <model name="bottlesumo_rev2">

    <!-- ============================================================ -->
    <!-- Base Chassis Link (220x180mm carbon fiber plate)              -->
    <!-- ============================================================ -->
    <link name="base_link">
      <pose>0 0 0.0015 0 0 0</pose>
      <inertial>
        <mass>0.372</mass>
        <inertia>
          <ixx>0.00161</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00201</iyy><iyz>0</iyz>
          <izz>0.00362</izz>
        </inertia>
      </inertial>
      <visual name="chassis_visual">
        <geometry>
          <mesh>
            <uri>model://bottlesumo_rev2/meshes/bottlesumo_rev2_chassis_plate.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="chassis_collision">
        <geometry>
          <box>
            <size>0.220 0.180 0.003</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- ============================================================ -->
    <!-- Left Wheel (48mm dia, continuous revolute)                    -->
    <!-- ============================================================ -->
    <link name="left_wheel">
      <pose>-0.085 0 0.0015 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>0.000005</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000005</iyy><iyz>0</iyz>
          <!-- wheel izz + N20 gearmotor reflected inertia (J_rotor~1e-7 * 40^2 * eta0.8 = 1.28e-4);
               dominates wheel inertia ~8e-6 by ~16x; stabilizes diff-drive control loop (load-test verified) -->
          <izz>0.000136</izz>
        </inertia>
      </inertial>
      <visual name="left_wheel_visual">
        <geometry>
          <mesh>
            <uri>model://bottlesumo_rev2/meshes/bottlesumo_rev2_wheel_left.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="left_wheel_collision">
        <geometry><cylinder><radius>0.024</radius><length>0.010</length></cylinder></geometry>
      </collision>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
      <!-- N20 300rpm gearmotor joint dynamics (physical, verified by load test):
           Gazebo treats <dynamics friction> as VISCOSUS damping (N*m*s/rad). Old 0.2 ->
           6.3 N*m @ 31.4 rad/s = 21x stall -> robot could never move. 0.02 verified:
           steady 31.18 rad/s = 300rpm, odom 0.523 m/s ≈ 98% theoretical. -->
      <dynamics damping="0.001" friction="0.02" />
      <limit><effort>0.3</effort><velocity>31.4</velocity></limit>
    </joint>

    <!-- ============================================================ -->
    <!-- Right Wheel (48mm dia, continuous revolute)                   -->
    <!-- ============================================================ -->
    <link name="right_wheel">
      <pose>0.085 0 0.0015 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>0.000005</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000005</iyy><iyz>0</iyz>
          <!-- wheel izz + N20 gearmotor reflected inertia (J_rotor~1e-7 * 40^2 * eta0.8 = 1.28e-4);
               dominates wheel inertia ~8e-6 by ~16x; stabilizes diff-drive control loop (load-test verified) -->
          <izz>0.000136</izz>
        </inertia>
      </inertial>
      <visual name="right_wheel_visual">
        <geometry>
          <mesh>
            <uri>model://bottlesumo_rev2/meshes/bottlesumo_rev2_wheel_right.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="right_wheel_collision">
        <geometry><cylinder><radius>0.024</radius><length>0.010</length></cylinder></geometry>
      </collision>
    </link>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
      <!-- N20 300rpm gearmotor joint dynamics (physical, verified by load test) -->
      <dynamics damping="0.001" friction="0.02" />
      <limit><effort>0.3</effort><velocity>31.4</velocity></limit>
    </joint>

    <!-- ============================================================ -->
    <!-- PCB Board (80x50x1.6mm, fixed)                                -->
    <!-- ============================================================ -->
    <link name="pcb">
      <pose>-0.030 0 0.0038 0 0 0</pose>
      <inertial>
        <mass>0.012</mass>
        <inertia>
          <ixx>0.000010</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000025</iyy><iyz>0</iyz>
          <izz>0.000035</izz>
        </inertia>
      </inertial>
      <visual name="pcb_visual">
        <geometry>
          <mesh>
            <uri>model://bottlesumo_rev2/meshes/bottlesumo_rev2_pcb.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="pcb_collision">
        <geometry><box><size>0.080 0.050 0.0016</size></box></geometry>
      </collision>
    </link>
    <joint name="pcb_joint" type="fixed">
      <parent>base_link</parent>
      <child>pcb</child>
    </joint>

    <!-- ============================================================ -->
    <!-- Battery (3S 18650 pack, fixed below chassis)                  -->
    <!-- ============================================================ -->
    <link name="battery">
      <pose>0 0 -0.0125 0 0 0</pose>
      <inertial>
        <mass>0.135</mass>
        <inertia>
          <ixx>0.00008</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00012</iyy><iyz>0</iyz>
          <izz>0.00015</izz>
        </inertia>
      </inertial>
      <visual name="battery_visual">
        <geometry>
          <mesh>
            <uri>model://bottlesumo_rev2/meshes/bottlesumo_rev2_battery.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="battery_collision">
        <geometry><box><size>0.070 0.056 0.022</size></box></geometry>
      </collision>
    </link>
    <joint name="battery_joint" type="fixed">
      <parent>base_link</parent>
      <child>battery</child>
    </joint>

    <!-- ============================================================ -->
    <!-- Left Motor (N20 gearmotor, fixed to chassis)                  -->
    <!-- ============================================================ -->
    <link name="left_motor">
      <pose>-0.085 0 0.0165 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>0.000003</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000003</iyy><iyz>0</iyz>
          <izz>0.000002</izz>
        </inertia>
      </inertial>
      <visual name="left_motor_visual">
        <geometry>
          <mesh>
            <uri>model://bottlesumo_rev2/meshes/bottlesumo_rev2_motor.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="left_motor_joint" type="fixed">
      <parent>base_link</parent>
      <child>left_motor</child>
    </joint>

    <!-- ============================================================ -->
    <!-- Right Motor (N20 gearmotor, fixed to chassis)                 -->
    <!-- ============================================================ -->
    <link name="right_motor">
      <pose>0.085 0 0.0165 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>0.000003</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000003</iyy><iyz>0</iyz>
          <izz>0.000002</izz>
        </inertia>
      </inertial>
      <visual name="right_motor_visual">
        <geometry>
          <mesh>
            <uri>model://bottlesumo_rev2/meshes/bottlesumo_rev2_motor.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="right_motor_joint" type="fixed">
      <parent>base_link</parent>
      <child>right_motor</child>
    </joint>

    <!-- ============================================================ -->
    <!-- SENSOR PLUGINS (match Rev2 hardware spec)                     -->
    <!-- ============================================================ -->

    <!-- ── VL53L1X Ray Sensor: Forward long-range bottle detector ── -->
    <!-- Spec: 27° FoV, 4m range, 50ms measurement time in long-range mode -->
    <sensor name="vl53l1x_bottle" type="ray">
      <pose>0.105 0 0.006 0 0 0</pose>
      <always_on>1</always_on>
      <update_rate>20</update_rate>  <!-- matches 50ms / 20Hz -->
      <ray>
        <scan>
          <horizontal>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </horizontal>
        </scan>
        <range><min>0.03</min><max>4.0</max></range>
        <noise type="gaussian">
          <mean>0</mean>
          <stddev>0.03</stddev>  <!-- ±3cm @ 1m, VL53L1X spec -->
        </noise>
      </ray>
      <plugin name="vl53l1x_driver" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/bottlesumo</namespace>
          <remapping>~/out:=vl53l1x_bottle</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
      </plugin>
    </sensor>

    <!-- ── VL53L0X ×4: Edge detection ToF sensors ── -->
    <!-- Spec: 25° FoV, 2m range, ±3% noise, I2C address 0x30-0x33 -->

    <!-- Front-Left Edge -->
    <sensor name="vl53l0x_front_left" type="ray">
      <pose>0.100 -0.025 0.005 0 0 -0.7854</pose>  <!-- 45° outward -->
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>1</samples><resolution>1</resolution>
            <min_angle>0</min_angle><max_angle>0</max_angle>
          </horizontal>
        </scan>
        <range><min>0.03</min><max>2.0</max></range>
        <noise type="gaussian"><mean>0</mean><stddev>0.015</stddev></noise>
      </ray>
    </sensor>

    <!-- Front-Right Edge -->
    <sensor name="vl53l0x_front_right" type="ray">
      <pose>0.100 0.025 0.005 0 0 0.7854</pose>
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>1</samples><resolution>1</resolution>
            <min_angle>0</min_angle><max_angle>0</max_angle>
          </horizontal>
        </scan>
        <range><min>0.03</min><max>2.0</max></range>
        <noise type="gaussian"><mean>0</mean><stddev>0.015</stddev></noise>
      </ray>
    </sensor>

    <!-- Left Edge -->
    <sensor name="vl53l0x_left_edge" type="ray">
      <pose>-0.100 0 0.005 0 0 -1.5708</pose>
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>1</samples><resolution>1</resolution>
            <min_angle>0</min_angle><max_angle>0</max_angle>
          </horizontal>
        </scan>
        <range><min>0.03</min><max>2.0</max></range>
        <noise type="gaussian"><mean>0</mean><stddev>0.015</stddev></noise>
      </ray>
    </sensor>

    <!-- Right Edge -->
    <sensor name="vl53l0x_right_edge" type="ray">
      <pose>0.100 0 0.005 0 0 1.5708</pose>
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>1</samples><resolution>1</resolution>
            <min_angle>0</min_angle><max_angle>0</max_angle>
          </horizontal>
        </scan>
        <range><min>0.03</min><max>2.0</max></range>
        <noise type="gaussian"><mean>0</mean><stddev>0.015</stddev></noise>
      </ray>
    </sensor>

    <!-- ── IMU: MPU6050 (gyro + accel) ── -->
    <sensor name="mpu6050_imu" type="imu">
      <pose>0 0 0.005 0 0 0</pose>
      <always_on>1</always_on>
      <update_rate>200</update_rate>
      <imu>
        <gyroscope>
          <noise type="gaussian"><mean>0</mean><stddev>0.000175</stddev></noise>     <!-- 0.01°/s -->
          <bias><mean>0</mean><stddev>0.001</stddev></bias>
        </gyroscope>
        <accelerometer>
          <noise type="gaussian"><mean>0</mean><stddev>0.0015</stddev></noise>
          <bias><mean>0</mean><stddev>0.0001</stddev></bias>
        </accelerometer>
      </imu>
      <plugin name="imu_driver" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/bottlesumo</namespace>
          <remapping>~/out:=imu</remapping>
        </ros>
      </plugin>
    </sensor>

    <!-- ── Differential Drive Controller (N20 motors via TB6612FNG) ── -->
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/bottlesumo</namespace>
      </ros>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.170</wheel_separation>   <!-- 170mm track -->
      <wheel_diameter>0.048</wheel_diameter>         <!-- 48mm N20 wheel (design_spec.json authority) -->
      <max_wheel_torque>0.3</max_wheel_torque>      <!-- N20 6V 300rpm stall torque ~0.3 Nm (motor_spec.json) -->
      <max_wheel_acceleration>200.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_wheel_tf>false</publish_wheel_tf>
      <command_timeout>0.5</command_timeout>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_wheel_joint_controllers>true</publish_wheel_joint_controllers>
      <wheel_radius>0.024</wheel_radius>
      <!-- Motor model: friction + velocity limits -->
      <torque><linear_coefficient>0.001</linear_coefficient></torque>
    </plugin>

  </model>
</sdf>
