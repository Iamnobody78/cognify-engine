{
  "experiment": "ablation_curriculum_vs_penalty",
  "question": "V10-C+D的+25.5%效应中, reverse curriculum和50x边缘惩罚各自的因果贡献?",
  "hypothesis": "50x惩罚是主因(reward shaping), curriculum是辅助(学习效率)",
  "design": "2x2 factorial",
  "factors": [
    {
      "name": "curriculum",
      "levels": ["none", "reverse (aggressive first)"],
      "description": "训练初期先学攻击(给予攻击性对手), 后期引入边缘危险"
    },
    {
      "name": "edge_penalty",
      "levels": ["normal (1x)", "strong (50x)"],
      "description": "danger reward: -10 vs -500"
    }
  ],
  "conditions": [
    {"id": "A", "curriculum": "none", "edge_penalty": "normal", "label": "baseline (V10-C equivalent)", "expected_wr": 47},
    {"id": "B", "curriculum": "none", "edge_penalty": "strong", "label": "仅强惩罚", "expected_wr": "unknown"},
    {"id": "C", "curriculum": "reverse", "edge_penalty": "normal", "label": "仅curriculum", "expected_wr": "unknown"},
    {"id": "D", "curriculum": "reverse", "edge_penalty": "strong", "label": "V10-C+D original", "expected_wr": 72.5}
  ],
  "causal_effects_to_estimate": [
    {"effect": "penalty_main", "formula": "mean(B,D) - mean(A,C)", "interpretation": "惩罚的边际因果效应"},
    {"effect": "curriculum_main", "formula": "mean(C,D) - mean(A,B)", "interpretation": "curriculum的边际因果效应"},
    {"effect": "interaction", "formula": "(D-A) - [(B-A)+(C-A)]", "interpretation": "交互效应: curriculum+惩罚是超加性还是亚加性?"}
  ],
  "fixed_config": {
    "use_double_dqn": true,
    "use_dueling": false,
    "use_action_mask": false,
    "n_episodes": 1500,
    "lr": 1e-4
  },
  "n_runs_per_condition": 3,
  "total_runs": 12,
  "note": "每条件3次重复以估计方差。若交互效应>0, 说明curriculum+惩罚的组合产生超出各自单独贡献的额外收益。"
}
