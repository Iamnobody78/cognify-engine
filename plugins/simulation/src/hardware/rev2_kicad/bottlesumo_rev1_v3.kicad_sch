      # ══════════════════════════════════════════
      # NET LIST (manual wiring in KiCad GUI)
      # ══════════════════════════════════════════
      # POWER:
      #   BAT+ -> SS34 -> PTC_2A -> VBAT bus
      #   VBAT -> MP1584(IN) -> +5V(3A) -> Pi 5V pins + Servo + TB6612 VCC
      #   +5V -> AMS1117-3.3(IN) -> +3V3 -> STM32 + sensors + VL53L5CX
      # MCU:
      #   XTAL(8MHz) + 2x22pF -> OSC_IN/OUT (PD0/PD1)
      #   NRST: 10k to +3V3, 100nF to GND, SW1 to GND
      #   BOOT0: 10k to GND
      #   VDDA: +3V3 -> FB1 -> VDDA | VDDA -> C15(10uF)+C16(100nF) -> GND
      # COMM:
      #   UART: Pi GPIO14(TXD) <-> STM32 PA10(RX)
      #         Pi GPIO15(RXD) <-> STM32 PA9(TX)
      #   I2C:  Pi GPIO2(SDA) <-> VL53L5CX SDA (NO external pull-up, Pi built-in)
      #         Pi GPIO3(SCL) <-> VL53L5CX SCL (R1/R2 DNP)
      # SENSORS:
      #   FRONT/BACK/LEFT/RIGHT: DO -> 100R -> STM32 PA0/PA1/PB6/PB7
      #   Each DO line: 100pF to GND at STM32 pin (RC filter)
      # MOTOR:
      #   TB6612 VCC = +5V (was 3.3V in v2)
      #   TB6612 STBY = +5V (pulled high)
      #   PWMA/B, AIN1/2, BIN1/2 -> STM32 timer outputs
      # SERVO:
      #   STM32 PA1(TIM2_CH2) -> 74HC245(A) -> 74HC245(B) -> J2(SERVO_PWM)
      #   74HC245 VCCA=3.3V, VCCB=5V, DIR=HIGH (A->B)
      # ══════════════════════════════════════════

