  (gr_line (start -75 -75) (end 75 -75) (layer "Edge.Cuts") (width 0.1) (tstamp aaaaaaaa-bbbb-cccc-dddd-000000000001))
  (gr_line (start 75 -75) (end 75 75) (layer "Edge.Cuts") (width 0.1) (tstamp aaaaaaaa-bbbb-cccc-dddd-000000000002))
