# ============================================================================
# ABDL System Rules v1.0
# Unified rules from: constitution.yaml + meta_rules.json + core_instruction.md
# ============================================================================
# This file IS the single source of truth for all agent behavior rules.
# Previous fragmented files are deprecated in favor of this unified format.
# ============================================================================

version: "1.0"
generated: "2026-08-01"
total_rules: 26

rules:
  # ==========================================================================
  # LEVEL 0: IMMUTABLE AXIOMS (cannot modify without human + 3 cosigners)
  # ==========================================================================

  - id: "AXIOM-SAFETY"
    level: 0
    condition: "decision.safety_impact == 'negative'"
    action: "BLOCK(decision) AND ALERT(CRITICAL, 'safety_violation') AND ESCALATE(hermes_leader)"
    priority: 1000
    description: "Safety always overrides all other considerations"
    context: "global"
    source: "existence_declaration.yaml > immutable_axioms > SAFETY_ABOVE_ALL"

  - id: "AXIOM-REVERSIBLE"
    level: 0
    condition: "decision.reversibility == 'irreversible' AND NOT(decision.has_checkpoint)"
    action: "BLOCK(decision) AND CHECKPOINT('pre_action') AND REQUEST_HUMAN('Irreversible action requires confirmation')"
    priority: 950
    description: "Irreversible actions require checkpoint + human confirmation"
    context: "global"
    source: "existence_declaration.yaml > immutable_axioms > REVERSIBLE_OVER_IRREVERSIBLE"

  - id: "AXIOM-EXPLAINABLE"
    level: 0
    condition: "decision.explainability == 'blackbox' AND decision.impact_level == 'high'"
    action: "BLOCK(decision) AND ALERT(WARNING, 'blackbox_high_impact') AND REQUEST_HUMAN('Blackbox high-impact decision requires review')"
    priority: 900
    description: "High-impact decisions must be explainable"
    context: "global"
    source: "existence_declaration.yaml > immutable_axioms > EXPLAINABLE_OVER_BLACKBOX"

  - id: "AXIOM-BUDGET"
    level: 0
    condition: "config(daily_cost) > config(budget_limit)"
    action: "BLOCK(tier2_workers) AND ALERT(CRITICAL, 'budget_exceeded') AND LOG('daily_budget_hit')"
    priority: 850
    description: "Never exceed daily $5 API budget"
    context: "budget_control"
    source: "existence_declaration.yaml > immutable_axioms > BUDGET_SANCTITY"

  - id: "AXIOM-PERSISTENCE"
    level: 0
    condition: "decision.type == 'promote_rule' AND metric(confirmed_rounds) < 3"
    action: "BLOCK(decision) AND MODIFY(decision, confirmed_rounds=metric(confirmed_rounds)+1)"
    priority: 800
    description: "Rules require 3 consecutive round confirmations before promotion"
    context: "shadow_loop"
    source: "existence_declaration.yaml > immutable_axioms > PERSISTENCE_OVER_VOLATILITY"

  # ==========================================================================
  # LEVEL 1: CONSTITUTIONAL RULES (core governance)
  # ==========================================================================

  - id: "GOV-ROUTING"
    level: 1
    condition: "EXISTS(task) AND NOT(task.assigned_agent)"
    action: "EXECUTE(route_task) AND LOG('task_routed')"
    priority: 700
    description: "All tasks must be routed to an agent within 1s of arrival"
    context: "hermes_leader"
    source: "hermes_leader_rules.md > Task Routing Rules"

  - id: "GOV-HEARTBEAT"
    level: 1
    condition: "sensor(agent_heartbeat_gap) > 15 AND sensor(agent_heartbeat_gap) <= 60"
    action: "ALERT(WARNING, 'agent_degraded') AND ESCALATE(meta_scheduler)"
    priority: 650
    description: "Degrade agent if heartbeat gap exceeds 15s"
    context: "health_monitoring"
    source: "hermes_leader_rules.md > Health Monitoring"

  - id: "GOV-STOPPED-AGENT"
    level: 1
    condition: "sensor(agent_heartbeat_gap) > 60"
    action: "ALERT(CRITICAL, 'agent_stopped') AND EXECUTE(reassign_tasks) AND LOG('agent_marked_stopped')"
    priority: 640
    description: "Mark agent STOPPED and reassign tasks if heartbeat gap exceeds 60s"
    context: "health_monitoring"
    depends_on: ["GOV-HEARTBEAT"]
    source: "hermes_leader_rules.md > Health Monitoring"

  - id: "GOV-CONFLICT-RESOLUTION"
    level: 1
    condition: "EXISTS(conflict) AND EXISTS(conflict.agents)"
    action: "EXECUTE(arbitrate_conflict) AND LOG('conflict_resolved')"
    priority: 600
    description: "Conflicts between agents resolved via priority queue P0 > P1 > P2 > P3 > P4"
    context: "conflict_arbitration"
    source: "hermes_leader_rules.md > Arbitration Rules"

  - id: "GOV-SESSION-INIT"
    level: 1
    condition: "state(system_status) == 'starting'"
    action: "EXECUTE(broadcast_session_init) AND LOG('session_started')"
    priority: 500
    description: "Leader broadcasts session.init to all agents on system start"
    context: "session_management"
    source: "hermes_leader_rules.md > Session Management"

  # ==========================================================================
  # LEVEL 2: OPERATIONAL RULES (day-to-day decision)
  # ==========================================================================

  - id: "OPS-META-HARNESS-TRIGGER"
    level: 2
    condition: "metric(consecutive_wr_drops) >= 3"
    action: "EXECUTE(trigger_meta_harness) AND ALERT(WARNING, 'scheduler_debt') AND LOG('meta_harness_triggered')"
    priority: 450
    description: "Auto-trigger Meta-Harness when WR drops 3 consecutive rounds >10%"
    context: "meta_harness"
    source: "core_instruction.md > Meta-Harness Auto-Trigger"

  - id: "OPS-AUDIT-SCHEDULE"
    level: 2
    condition: "sensor(time_since_last_audit_hours) > 12"
    action: "EXECUTE(full_meta_audit) AND LOG('scheduled_audit')"
    priority: 400
    description: "Run full meta-audit every 12 hours"
    context: "meta_audit"
    source: "team_constitution.yaml > audit"

  - id: "OPS-SECURITY-SCAN"
    level: 2
    condition: "EXISTS(incoming_code) OR sensor(time_since_last_scan_hours) > 1"
    action: "EXECUTE(security_scan) AND LOG('security_checked')"
    priority: 380
    description: "Run security scan on every incoming code change or hourly"
    context: "security"
    source: "team_constitution.yaml > audit > safety_check"

  - id: "OPS-EDGE-AVOIDANCE"
    level: 2
    condition: "sensor(min_edge_distance) < 0.25"
    action: "EXECUTE(avoidance_maneuver) AND LOG('edge_avoidance_triggered')"
    priority: 350
    confidence: 0.92
    description: "Execute avoidance when any edge sensor reads < 0.25m"
    context: "edge_detection"
    source: "meta_rules.json > edge_safety"

  - id: "OPS-OPPONENT-DETECT"
    level: 2
    condition: "sensor(opponent_distance) < 0.5 AND sensor(opponent_confidence) > 0.8"
    action: "EXECUTE(engagement_strategy) AND ALERT(INFO, 'opponent_detected')"
    priority: 340
    confidence: 0.88
    description: "Switch to engagement when opponent detected within 0.5m with high confidence"
    context: "opponent_detection"
    source: "meta_rules.json > opponent"

  - id: "OPS-MEMORY-COMPACT"
    level: 2
    condition: "sensor(token_usage_pct) > 90"
    action: "EXECUTE(memory_compaction) AND LOG('compaction_triggered')"
    priority: 300
    description: "Trigger memory compaction when context usage exceeds 90%"
    context: "memory_management"
    source: "hermes_leader_rules.md > Health Monitoring"

  - id: "OPS-SHADOW-EVALUATE"
    level: 2
    condition: "metric(new_candidates_count) > 0"
    action: "EXECUTE(shadow_evaluation_loop) AND LOG('shadow_cycle')"
    priority: 280
    description: "Run shadow evaluation loop whenever new candidates exist"
    context: "shadow_loop"
    source: "core_instruction.md > Shadow Loop"

  - id: "OPS-GUI-TEST"
    level: 2
    condition: "state(firmware_modified) == true"
    action: "EXECUTE(gui_regression_test) AND LOG('gui_tested')"
    priority: 260
    description: "Run GUI regression tests after firmware modifications"
    context: "gui_testing"
    source: "core_instruction.md > GUI Agent"

  # ==========================================================================
  # LEVEL 3: HEURISTIC RULES (auto-evolving tactical optimization)
  # ==========================================================================

  - id: "HEU-SPEED-ADAPT"
    level: 3
    condition: "sensor(opponent_speed) > sensor(my_speed) AND sensor(distance_to_bottle) > 1.0"
    action: "MODIFY(motor_power, multiplier=1.2) AND LOG('speed_boost')"
    priority: 200
    confidence: 0.75
    description: "Increase motor power when opponent is faster and bottle is far"
    context: "motor_control"
    source: "harness_candidates.json > speed_boost_strategy"

  - id: "HEU-DEFENSIVE-STANCE"
    level: 3
    condition: "sensor(bottle_possession) == 'opponent' AND sensor(distance_to_opponent) < 0.3"
    action: "EXECUTE(defensive_block) AND LOG('defensive_triggered')"
    priority: 190
    confidence: 0.82
    description: "Switch to defensive blocking when opponent has bottle nearby"
    context: "strategy"
    source: "shadow_loop > promoted_rule_042"

  - id: "HEU-EXPLORATION-BUDGET"
    level: 3
    condition: "NOT(EXISTS(exploration_allocation)) OR metric(exploration_rounds_pct) < 20"
    action: "EXECUTE(random_exploration) AND LOG('exploration_round')"
    priority: 150
    confidence: 0.90
    description: "Maintain 20% exploration budget to prevent echo chamber"
    context: "strategy_diversity"
    source: "existence_declaration.yaml > axiology > tradeoff_matrix"
    depends_on: ["AXIOM-PERSISTENCE"]

  - id: "HEU-CANDIDATE-PRUNE"
    level: 3
    condition: "metric(candidates_count) > 50"
    action: "EXECUTE(prune_stale_candidates) AND LOG('candidate_pruned')"
    priority: 100
    confidence: 0.85
    description: "Prune stale candidates when pool exceeds 50"
    context: "meta_harness"
    source: "meta_harness_adapter.py > candidate_management"

  - id: "HEU-WARM-START"
    level: 3
    condition: "state(system_status) == 'restarting' AND EXISTS(previous_session_data)"
    action: "EXECUTE(load_checkpoint) AND LOG('warm_start')"
    priority: 80
    confidence: 0.95
    description: "Warm-start from checkpoint on system restart"
    context: "recovery"
    source: "core_instruction.md > Session Management"

  - id: "HEU-RULE-CONFIDENCE-DECAY"
    level: 3
    condition: "rule.confidence < 0.5 AND NOT(EXISTS(rule.fallback))"
    action: "ALERT(WARNING, 'low_confidence_rule') AND EXECUTE(fallback_to_default)"
    priority: 60
    confidence: 0.88
    description: "Fall back to default when rule confidence drops below 0.5"
    context: "rule_management"
    source: "abdl_schema.yaml > validation"

# ============================================================================
# RULE DEPENDENCY GRAPH (for consistency checking)
# ============================================================================
dependencies:
  "AXIOM-PERSISTENCE": ["HEU-EXPLORATION-BUDGET"]  # exploration depends on persistence
  "GOV-HEARTBEAT": ["GOV-STOPPED-AGENT"]           # stopped depends on heartbeat detection
  conflicts: []  # No conflicts detected in v1.0
